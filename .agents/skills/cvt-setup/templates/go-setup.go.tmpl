// Minimal CVT contract test — adapt schema path and endpoint to your API
package contracttest

import (
	"context"
	"os"
	"testing"

	"github.com/sahina/cvt/sdks/go/cvt"
)

func TestGetUser(t *testing.T) {
	addr := os.Getenv("CVT_SERVER")
	if addr == "" {
		addr = "localhost:9550"
	}
	v, err := cvt.NewValidator(addr)
	if err != nil {
		t.Fatalf("failed to create validator: %v", err)
	}
	defer v.Close()

	ctx := context.Background()
	if err := v.RegisterSchema(ctx, "my-api", "./path/to/openapi.json"); err != nil {
		t.Fatalf("failed to register schema: %v", err)
	}

	result, err := v.Validate(ctx,
		cvt.ValidationRequest{Method: "GET", Path: "/users/123", Headers: map[string]string{"Accept": "application/json"}},
		cvt.ValidationResponse{StatusCode: 200, Headers: map[string]string{"Content-Type": "application/json"}, Body: map[string]interface{}{"id": "123", "name": "Jane Doe"}},
	)
	if err != nil {
		t.Fatalf("validation error: %v", err)
	}
	if !result.Valid {
		t.Errorf("expected valid interaction, got errors: %v", result.Errors)
	}
}
